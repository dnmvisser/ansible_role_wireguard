{% if not wg_stealth_mode | bool %}
# {{ ansible_managed }}
{% endif %}
[Interface]
Address = {{ wg_tunnel_addresses | join(',') }}
ListenPort = {{ wg_server_port }}
PrivateKey = {{ wg_private_key }}
{% if not wg_stealth_mode | bool %}
# public key = {{ wg_public_key }}
{% endif %}
{# PostUp #}
{% if wg_postup is defined and wg_postup | length > 0 %}
{% if wg_postup is string %}
PostUp = {{ wg_postup }}
{% elif wg_postup is iterable %}
{% for cmd in wg_postup %}
PostUp = {{ cmd | replace(';', '\;') }}
{% endfor %}
{% endif %}
{% endif %}
{# PostDown #}
{% if wg_postdown is defined and wg_postdown | length > 0 %}
{% if wg_postdown is string %}
PostUp = {{ wg_postdown }}
{% elif wg_postdown is iterable %}
{% for cmd in wg_postdown %}
PostUp = {{ cmd | replace(';', '\;') }}
{% endfor %}
{% endif %}
{% endif %}
{# client part #}
{% for client in wg_clients %}
{% if not wg_stealth_mode | bool %}
# {{ client.name }}
{% endif %}
[Peer]
PublicKey = {{ client.public_key }}
PresharedKey = {{ client.preshared_key }}
AllowedIPs = {{
  ([wg_tunnel_prefix_ipv6 | ansible.utils.ipaddr(loop.index+1) | ansible.utils.ipaddr('address') ~ '/128'] if wg_ipv6_enable else []) | union(
  ([wg_tunnel_prefix_ipv4 | ansible.utils.ipaddr(loop.index+1) | ansible.utils.ipaddr('address') ~ '/32'] if wg_ipv4_enable else [])) |
  sort(reverse=True) | ansible.utils.ipaddr | join(',') }}
{% endfor %}
