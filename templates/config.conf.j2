{% if not wg_stealth_mode | bool %}
# {{ ansible_managed }}
# Wireguard mode: {{ wg_mode }}
{% endif %}
[Interface]
Address = {{ wg_tunnel_addresses | join(',') }}
ListenPort = {{ wg_server_port }}
PrivateKey = {{ wg_private_key }}
{% if not wg_stealth_mode | bool %}
# public key = {{ wg_public_key }}
{% endif %}

{# PostUp #}
{% for cmd in wg_postup | select %}
PostUp = {{ cmd | replace(';', '\;') }}
{% endfor %}

{# PostDown #}
{% for cmd in wg_postdown | select %}
PostDown = {{ cmd | replace(';', '\;') }}
{% endfor %}

{# client part #}
{% for profile in profiles %}
[Peer]
{% if not wg_stealth_mode | bool %}
# {{ profile.client.name }}
{% endif %}
PublicKey = {{ profile.client.public_key }}
PresharedKey = {{ profile.client.preshared_key }}
AllowedIPs = {{ profile.client_addresses | join(',') }}
{% endfor %}
