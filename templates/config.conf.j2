{% if not wg_stealth_mode | bool %}
# {{ ansible_managed }}
# Wireguard server mode: {{ wg_mode }}
{% endif %}
[Interface]
Address = {{ wg_tunnel_addresses | join(',') }}
ListenPort = {{ wg_server_port }}
PrivateKey = {{ wg_private_key }}
{% if not wg_stealth_mode | bool %}
# public key = {{ wg_public_key }}
{% endif %}

{# PostUp #}
{% for cmd in wg_postup | select %}
PostUp = {{ cmd | replace(';', '\;') }}
{% endfor %}

{# PostDown #}
{% for cmd in wg_postdown | select %}
PostDown = {{ cmd | replace(';', '\;') }}
{% endfor %}

{# client part #}
{% for client in _wg_clients %}
{% set label = client.cn | default(client.mail) | default(client.id) %}
[Peer]
{% if not wg_stealth_mode | bool %}
# {{ label }}
{% endif %}
PublicKey = {{ client.public_key }}
{% if 'preshared_key' in client %}
PresharedKey = {{ client.preshared_key }}
{% endif %}
AllowedIPs = {{ client.addresses | join(',') }}
{% endfor %}
{% if wg_clients | length > 0 %}
# Peer list in JSON format, to be used by script..
# {{
  wg_clients
  | map('ansible.builtin.dict2items')
  | map('selectattr', 'in', ['id', 'public_key'])
  | map('list')
  | map('ansible.builtin.items2dict')
  | list
  | to_json }}
{% endif %}
