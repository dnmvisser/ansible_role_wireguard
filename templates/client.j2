# WireGuard profile '{{ profile.tunnel }}' for user {{ label }}
# Generated at {{ ansible_facts['date_time'].iso8601_micro }}
[Interface]
Address = {{
  (client.addresses | ansible.utils.ipv6 if profile.allowedips | ansible.utils.ipv6 else [])
  | union(
    (client.addresses | ansible.utils.ipv4 if profile.allowedips | ansible.utils.ipv4 else [])
  )
  | join(',')
}}
PrivateKey = {{ client.private_key | default('REPLACE_WITH_PRIVATE_KEY') }}
DNS = {{ [profile.resolver | default(wg_resolver)] | union(wg_dns_search_domains) | join(',') }}
[Peer]
PublicKey = {{ wg_public_key }}
{% if 'preshared_key' in client %}
PresharedKey = {{ client.preshared_key }}
{% endif %}
Endpoint = {{ wg_hostname }}:{{ wg_public_port }}
AllowedIPs = {{ profile.allowedips | ansible.utils.cidr_merge | join(',') }}
{% if peer_persistentkeepalive | int > 0 %}
PersistentKeepalive = {{ peer_persistentkeepalive }}
{% endif %}
